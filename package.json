{
  "name": "@juiceswap/deploy-v3",
  "version": "1.0.4",
  "description": "Deploy JuiceSwap V3 (Uniswap V3 fork) smart contracts on Citrea",
  "bin": "dist/index.js",
  "publishConfig": {
    "access": "restricted"
  },
  "main": "dist/index.js",
  "scripts": {
    "test": "mocha",
    "build": "ncc build index.ts -o dist -m",
    "postbuild": "cat shebang.txt dist/index.js > dist/index.cmd.js && mv dist/index.cmd.js dist/index.js",
    "prestart": "yarn build",
    "start": "node dist/index.js",
    "prepublishOnly": "yarn build",
    "compile": "npx hardhat compile",
    "node": "npx hardhat node",
    "node:fork:testnet": "FORK_TESTNET=true npx hardhat node",
    "node:fork:mainnet": "FORK_MAINNET=true npx hardhat node",
    "deploy:local": "npx hardhat run scripts/deploy.ts --network localhost",
    "deploy:fork:testnet": "FORK_TESTNET=true npx hardhat run scripts/deploy.ts --network hardhat",
    "deploy:fork:mainnet": "FORK_MAINNET=true npx hardhat run scripts/deploy.ts --network hardhat",
    "deploy:testnet": "npx hardhat run scripts/deploy.ts --network citreaTestnet",
    "deploy:mainnet": "npx hardhat run scripts/deploy.ts --network citrea",
    "verify:testnet": "DEPLOYMENT_FILE_PATH=./deployments/citreaTestnet/dex.json npx hardhat run scripts/verifyContracts.ts --network citreaTestnet",
    "verify:mainnet": "DEPLOYMENT_FILE_PATH=./deployments/citrea/dex.json npx hardhat run scripts/verifyContracts.ts --network citrea",
    "validate:hashes": "ts-node scripts/validateHashes.ts",
    "pretest:ecosystem": "npm run validate:hashes",
    "test:ecosystem": "hardhat run scripts/integration/fullEcosystemTest.ts --network localhost",
    "test:ecosystem:fork": "FORK_TESTNET=true hardhat run scripts/integration/fullEcosystemTest.ts --network hardhat",
    "test:deployed": "FORK_TESTNET=true hardhat run scripts/integration/testDeployedDex.ts --network hardhat"
  },
  "files": [
    "dist/"
  ],
  "engines": {
    "node": ">=12.18.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JuiceSwapXyz/deploy-v3.git"
  },
  "author": {
    "email": "contact@juiceswap.com",
    "name": "JuiceSwap",
    "url": "https://juiceswap.com"
  },
  "license": "GPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/JuiceSwapXyz/deploy-v3/issues"
  },
  "homepage": "https://juiceswap.com",
  "devDependencies": {
    "@ethersproject/abstract-signer": "^5.5.0",
    "@ethersproject/address": "^5.5.0",
    "@ethersproject/bignumber": "^5.5.0",
    "@ethersproject/constants": "^5.5.0",
    "@ethersproject/contracts": "^5.5.0",
    "@ethersproject/providers": "^5.5.1",
    "@ethersproject/wallet": "^5.5.0",
    "@juicedollar/jusd": "git+https://github.com/JuiceDollar/smartContracts.git#develop",
    "@juiceswap/smart-contracts": "git+https://github.com/JuiceSwapxyz/smart-contracts.git#develop",
    "@juiceswapxyz/swap-router-contracts": "1.0.1",
    "@juiceswapxyz/v2-core": "^1.0.0",
    "@juiceswapxyz/v2-periphery": "^1.0.0",
    "@juiceswapxyz/v3-core": "^1.0.0",
    "@juiceswapxyz/v3-periphery": "^1.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.0",
    "@nomiclabs/hardhat-ethers": "^2.2.3",
    "@openzeppelin/contracts": "3.4.1-solc-0.7-2",
    "@types/chai": "^4.2.12",
    "@types/mocha": "^8.0.3",
    "@types/node": "^14.6.3",
    "@uniswap/lib": "^4.0.1-alpha",
    "@uniswap/sdk-core": "^1.0.8",
    "@uniswap/v3-staker": "1.0.2",
    "@vercel/ncc": "^0.33.1",
    "base64-sol": "1.0.1",
    "chai": "^4.2.0",
    "commander": "^6.1.0",
    "dotenv": "^17.2.2",
    "ganache-cli": "^6.10.1",
    "hardhat": "^2.26.3",
    "immer": "^7.0.8",
    "mocha": "^8.1.3",
    "prettier": "^2.1.1",
    "ts-node": "^9.0.0",
    "typescript": "^4.0.2"
  },
  "dependencies": {
    "axios": "^1.12.2",
    "ethers": "5",
    "solc": "^0.7.6"
  }
}
