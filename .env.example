# Citrea Testnet Uniswap V3 Deployment Configuration

# Your private key (without 0x prefix)
# IMPORTANT: Never commit your actual private key!
PRIVATE_KEY=your_private_key_here

# The address that will own the deployed contracts after deployment
# This could be a multisig, DAO, or EOA address
OWNER_ADDRESS=your_owner_address_here

# Optional: Gas price in GWEI (if not set, will use network default)
# GAS_PRICE=10