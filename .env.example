# JuiceSwap V3 Deployment Configuration

# ===================================
# CITREA TESTNET DEPLOYMENT (Required)
# ===================================

# Deployer private key (with 0x prefix)
# IMPORTANT: Never commit your actual private key!
PRIVATE_KEY=0x1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef

# WcBTC (Wrapped cBTC) contract address on Citrea Testnet
# Required for testnet deployment
WETH9_ADDRESS=0x4370e27F7d91D9341bFf232d7Ee8bdfE3a9933a0

# Address that will own the deployed contracts
# Can be a multisig, DAO, or EOA address
# For local testing, defaults to deployer if not set
OWNER_ADDRESS=0x1234567890123456789012345678901234567890

# ===================================
# OPTIONAL CONFIGURATION
# ===================================

# Native currency label (shown in NFT metadata)
# Default: "cBTC"
NATIVE_CURRENCY_LABEL=cBTC

# Uniswap V2 factory address (for migration support)
# Leave unset or use zero address if no V2 deployment exists
# V2_FACTORY_ADDRESS=0x0000000000000000000000000000000000000000

# Gas price in GWEI
# Leave unset to use network default (recommended)
# GAS_PRICE=50

# ===================================
# LOCAL TESTING
# ===================================
# For localhost deployment, only PRIVATE_KEY is required
# WETH9Mock is automatically deployed
# OWNER_ADDRESS defaults to deployer
