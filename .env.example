# JuiceSwap V3 Deployment Configuration

# ===================================
# REQUIRED
# ===================================

# Deployer private key (with 0x prefix)
# IMPORTANT: Never commit your actual private key!
PRIVATE_KEY=0x...

# WcBTC (Wrapped Citrea Bitcoin) contract address
# This is a Citrea system contract - same address on testnet and mainnet:
WETH9_ADDRESS=0x3100000000000000000000000000000000000006

# ===================================
# OPTIONAL
# ===================================

# Address that will own the deployed contracts (V3 Factory, ProxyAdmin, V2 Factory)
# Defaults to deployer address if not set
# Ownership is transferred to Governor in Step 5 of deployment
# OWNER_ADDRESS=0x...

# Native currency label (shown in NFT position metadata)
# Default: "cBTC"
# NATIVE_CURRENCY_LABEL=cBTC

# Uniswap V2 factory address (for migration support)
# Leave unset or use zero address if no existing V2 deployment
# V2_FACTORY_ADDRESS=0x0000000000000000000000000000000000000000

# Force full redeploy (ignores existing deployment state)
# FULL_REDEPLOY=true

# ===================================
# LOCAL TESTING
# ===================================
# For localhost/hardhat deployment:
# - Only PRIVATE_KEY is required
# - WETH9Mock is automatically deployed
# - Deployment state is ephemeral (not saved)

# ===================================
# INTEGRATION TEST CONFIGURATION
# ===================================
# Optional: Override paths to external repos for fullEcosystemTest.ts
# Defaults assume standard folder structure (see README.md)

# Path to JuiceDollar/smartContracts repo
# JUSD_REPO_PATH=/path/to/JuiceDollar/smartContracts

# Path to JuiceSwap/smart-contracts (Governance) repo
# GOVERNANCE_REPO_PATH=/path/to/JuiceSwap/smart-contracts
